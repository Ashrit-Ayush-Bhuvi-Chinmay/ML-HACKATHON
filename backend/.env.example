# PathSnap backend runtime settings. Copy to .env and edit. No real secrets in this file.
APP_NAME=PathSnap Backend
APP_VERSION=1.0.0
APP_ENV=development

HOST=0.0.0.0
PORT=8000

# Comma-separated origins. "*" is required when laptop 2's URL is not known in advance.
ALLOWED_ORIGINS=*

# slowapi default limit for decorated routes.
RATE_LIMIT=60/minute

# Folder with one sub-folder per trip (or all trip files flat). Empty = auto-detect the
# supplied student_test folder from this checkout.
PATHSNAP_EVAL_DIR=

# Demo default is false: the UI sends no bearer token.
PATHSNAP_REQUIRE_AUTH=false

# Optional UDP LAN discovery. Needs a 64-hex-character secret (32 bytes), shared by both laptops.
PATHSNAP_DISCOVERY=false
DISCOVERY_SECRET=
